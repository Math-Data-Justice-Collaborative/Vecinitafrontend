# Vecinita Frontend Environment Variables

# Backend Gateway URL (unified API)
# Development: keep /api so Vite proxy handles backend routing and CORS (gateway default port 8004)
# Production: set to your deployed gateway URL (e.g. https://your-gateway/api/v1)
# Align with root `.env.local.example` / specs/005-wire-services-dm-front/contracts/env-wiring-chat-gateway-agent.md §ServiceEndpointConfig
VITE_GATEWAY_URL=/api

# Optional: Vite dev proxy target (used by vite.config.ts)
# Set this if your gateway runs on a different host/port
VITE_GATEWAY_PROXY_TARGET=http://127.0.0.1:8004

# Agent request timeouts (milliseconds).
# Ordering vs gateway: root `.env.local.example` defines `AGENT_TIMEOUT` / `AGENT_STREAM_TIMEOUT` (seconds).
# Keep each VITE_AGENT_* value **greater than** the matching gateway budget in ms (seconds × 1000) so the SPA does not abort before the gateway.
VITE_AGENT_REQUEST_TIMEOUT_MS=90000
VITE_AGENT_STREAM_TIMEOUT_MS=120000
VITE_AGENT_STREAM_FIRST_EVENT_TIMEOUT_MS=15000

# Direct admin browser authentication
# Provision these values through your deployment environment.
VITE_ADMIN_AUTH_ENABLED=true
VITE_ADMIN_EMAIL=admin@vecinita.local
VITE_ADMIN_PASSWORD=VecinitaAdmin!2026
VITE_ADMIN_TOKEN=vecinita-admin-token

# Legacy aliases VITE_DEV_ADMIN_* are still read if present, but new configs should use VITE_ADMIN_*.
