# Production Environment Variables for Vecinita Frontend
# Used during build process on Render
# These will be baked into the JavaScript bundle at build time

# Production Gateway URL - MUST be set to actual deployed gateway
# This fixes the "Failed to fetch" error by pointing the frontend to the real gateway
VITE_GATEWAY_URL=https://vecinita-gateway-prod-v5.onrender.com/api/v1

# Request timeouts
VITE_AGENT_REQUEST_TIMEOUT_MS=90000
VITE_AGENT_STREAM_TIMEOUT_MS=120000
VITE_AGENT_STREAM_FIRST_EVENT_TIMEOUT_MS=15000

# Admin authentication enabled in production
VITE_ADMIN_AUTH_ENABLED=true

# Supabase auth (configure in Render dashboard if using)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
